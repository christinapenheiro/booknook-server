{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/old-path", "destination": "/new-path", "permanent": true }
  ],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/handler.js" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-job",
      "schedule": "0 0 * * *"
    }
  ]
}
